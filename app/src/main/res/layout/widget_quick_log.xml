<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:paddingStart="6dp"
        android:text="@string/widget_title"
        android:textColor="#FF7FE3EC"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_bad"
            style="@style/WidgetButton"
            android:text="@string/widget_bad" />

        <TextView
            android:id="@+id/widget_good"
            style="@style/WidgetButton"
            android:text="@string/widget_good" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_side_effect"
            style="@style/WidgetButton"
            android:text="@string/widget_side_effect" />

        <TextView
            android:id="@+id/widget_rate"
            style="@style/WidgetButton"
            android:text="@string/widget_rate" />
    </LinearLayout>
</LinearLayout>
